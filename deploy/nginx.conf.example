# Replace agent.example.edu and the certificate paths before enabling this file.
server {
    listen 443 ssl http2;
    server_name agent.example.edu;

    ssl_certificate     /etc/letsencrypt/live/agent.example.edu/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/agent.example.edu/privkey.pem;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;

        # /api/chat uses streaming NDJSON; the event endpoints use SSE.
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        gzip off;
        add_header X-Accel-Buffering no always;

        proxy_connect_timeout 10s;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
    }
}

server {
    listen 80;
    server_name agent.example.edu;
    return 301 https://$host$request_uri;
}

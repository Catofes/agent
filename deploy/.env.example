# 必须与课堂 Agent 使用的 RUNNER_TOKEN 完全相同。
RUNNER_TOKEN=replace-with-a-long-random-token

# 40 人课堂的默认值：最多 16 个同时运行、64 个等待。
# RUNNER_CONCURRENCY=16
# RUNNER_QUEUE_CAPACITY=64

# 可选：正式部署建议改成与 Agent 一致的版本标签或审核后的 digest。
# PYTHON_RUNTIME_IMAGE=ghcr.io/catofes/agent-python-runtime:v0.6.1
# PYTHON_RUNNER_IMAGE=ghcr.io/catofes/agent-python-runner:v0.6.1
